# Rust gitignore
# Generated by Cargo - build artifacts and compilation outputs

# Compiled files and executables
/target/
**/*.rs.bk
*.pdb

# Cargo lock file (ignore for libraries, keep for binaries)
# Uncomment this line if you're building a library:
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb
*.exe

# MacOS
.DS_Store

# IDE / Editor specific
# VSCode
.vscode/
*.code-workspace

# IntelliJ Rust
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Visual Studio
.vs/

# CLion
cmake-build-*/

# Misc
*.log
*.tmp
.cache/

# OS generated
Thumbs.db

# Go gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories
vendor/

# Go build cache
.cache/

# IDE specific
# GoLand / IntelliJ
.idea/
*.iml

# VSCode
.vscode/
*.code-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#

# MacOS
.DS_Store

# Windows
Thumbs.db

# Environment variables
.env
.env.local

# Air (live reload tool)
tmp/

# Binaries
bin/
dist/

